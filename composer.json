{
    "name": "hubercms/hubercms",
    "description": "HuberCMS - Modern Open-Source CMS built in PHP 8.4",
    "type": "project",
    "license": "MIT",
    "keywords": ["cms", "php8.4", "mvc", "rest-api"],
    "authors": [
        {
            "name": "HuberCMS Contributors",
            "email": "dev@hubercms.io"
        }
    ],
    "require": {
        "php": "^8.4",
        "monolog/monolog": "^3.6",
        "phpmailer/phpmailer": "^6.9",
        "intervention/image": "^3.9",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/console": "^7.2",
        "league/flysystem": "^3.29",
        "defuse/php-encryption": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "HuberCMS\\": "app/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "HuberCMS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [],
        "test": "phpunit --colors=always",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
        "analyse": "phpstan analyse app --level=8"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
