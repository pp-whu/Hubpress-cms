# ============================================================
# HuberCMS Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME="HuberCMS"
APP_ENV=development
APP_DEBUG=true
APP_URL=https://cms.ddev.site
APP_KEY=                        # Generate: php artisan key:generate (or use /install)
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
# HTTPS-JSON-Quelle mit version/tag_name und download_url/zipball_url
HUBERCMS_UPDATE_URL=

# Database
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=db
DB_PASSWORD=db
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=hcms_

# Cache
CACHE_DRIVER=file               # file | redis | apcu | array
CACHE_TTL=3600
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session
SESSION_DRIVER=file             # file | database | redis
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Mail
MAIL_DRIVER=smtp                # smtp | sendmail | log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=                # tls | ssl | (empty)
MAIL_FROM_ADDRESS=noreply@hubercms.io
MAIL_FROM_NAME="${APP_NAME}"

# Security
BCRYPT_ROUNDS=12
JWT_SECRET=                     # Generate a random 64-char string
JWT_TTL=3600
CSRF_TTL=7200
RATE_LIMIT_MAX=100              # requests per minute
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=debug                 # debug | info | warning | error | critical
LOG_CHANNEL=daily               # single | daily | stderr

# File Upload
UPLOAD_MAX_SIZE=10485760        # 10 MB in bytes
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,avif,pdf,mp4,mp3,svg,zip
IMAGE_QUALITY=85
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300

# API
API_RATE_LIMIT=60               # requests per minute per key
API_VERSION=v1

# 2FA
TOTP_ISSUER="${APP_NAME}"

# AI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
